{
  "name": "tradify-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Tradify platform monorepo \u2014 web, tradie mobile app, member mobile app, shared packages",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "tradie:dev": "pnpm --filter tradie-app start",
    "tradie:ios": "pnpm --filter tradie-app ios",
    "tradie:android": "pnpm --filter tradie-app android",
    "member:dev": "pnpm --filter member-app start",
    "member:ios": "pnpm --filter member-app ios",
    "member:android": "pnpm --filter member-app android",
    "shared:build": "pnpm --filter @tradify/shared build",
    "ui:build": "pnpm --filter @tradify/ui build",
    "typecheck": "pnpm -r typecheck",
    "lint": "node web/node_modules/eslint/bin/eslint.js apps packages --config eslint.config.mjs",
    "test": "pnpm -r test",
    "demo:start": "composer --working-dir=web run dev"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@expo/dom-webview": "~57.0.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "~19.2.4",
      "react": "19.2.3",
      "react-native": "0.86.3",
      "@react-native/metro-config": "0.86.3",
      "@expo/dom-webview": "~57.0.1",
      "react-native-worklets": "0.10.1"
    }
  }
}
