{
  "expo": {
    "name": "Tradify Kenya Members",
    "slug": "tradify-member",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "au.com.tradify.member",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of the issue for your tradie.",
        "NSPhotoLibraryUsageDescription": "Choose photos from your library to describe the job.",
        "NSFaceIDUsageDescription": "Unlock Tradify with Face ID."
      }
    },
    "android": {
      "package": "au.com.tradify.member",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "USE_BIOMETRIC"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font"
    ],
    "updates": {
      "enabled": false
    }
  }
}
